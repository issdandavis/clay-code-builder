# `npm run dev` automatically connects /api/clay to ../loom/clay_ask.py.
# Copy this file to `.env` only if you need an override; no credential is required.
# CLAY_LOOM=C:\dev\loom
# CLAY_TUTOR_MODEL=clay
# CLAY_TUTOR_TIMEOUT_MS=45000

# Optional remote-compatible endpoint override. It receives only the active project context.
VITE_CLAY_API_URL=
